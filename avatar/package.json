{
  "name": "hermes-desktop-pet",
  "version": "0.1.3",
  "description": "Hermes Desktop Pet — Interactive AI Companion (Electron, Pixi.js, Live2D & Three.js)",
  "homepage": "https://github.com/KarmaSenzu/Hermes-Desktop-Pet",
  "repository": {
    "type": "git",
    "url": "https://github.com/KarmaSenzu/Hermes-Desktop-Pet.git"
  },
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "KarmaSenzu",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "doctor": "node scripts/doctor.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.3.0",
    "msedge-tts": "^1.2.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "three": "^0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "33.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.karmasenzu.hermesdesktoppet",
    "productName": "Hermes Desktop Pet",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "assets/**/*",
      "build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": ["*.py"]
      },
      {
        "from": "extensions",
        "to": "extensions"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.entertainment",
      "identity": null,
      "gatekeeperAssess": false,
      "hardenedRuntime": false
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Utility"
    }
  }
}
