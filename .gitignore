# ==============================================================================
# HERMES DESKTOP PET — ANTI-LEAKAGE & PRIVACY GITIGNORE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DEPENDENCIES & BUILD OUTPUTS
# ------------------------------------------------------------------------------
node_modules/
dist/
out/
release/
build/
!avatar/build/
.cache/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 2. LOGS & DEBUG RUNTIMES
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 3. KREDENSIAL, API KEYS, TOKEN, & SECRETS (ANTI-KEBOCORAN)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.cert
*.crt
*.pfx
*.p12
*.token
*session-token*
*credential*
# Catatan: pola `*secret*` sebelumnya terlalu luas (ikut "mencocokkan" file kode
# seperti secret-store.js sehingga menyesatkan). Ganti dengan pola tepat:
*.secret
secrets/
secrets.*
shortcuts.json
apps_cache.json
# File pengaturan runtime aplikasi (bisa memuat teks sensitif) — jangan di-commit
settings.json
settings.*.json
# Konfigurasi Hermes (.yaml/.yml) memuat api_key literal → jangan di-commit
config.yaml
config.yml
*.local.yaml
*.local.yml

# ------------------------------------------------------------------------------
# 4. PERCAKAPAN PRIBADI, RIWAYAT CHAT, & DATABASE MEMORI
# ------------------------------------------------------------------------------
*.jsonl
*.db
*.sqlite
*.sqlite3
memory/
sessions/
conversations/
chat_history/

# ------------------------------------------------------------------------------
# 5. DOKUMEN PRIBADI, INFORMASI INTERNAL, PATH LOKAL, & CATATAN DEV
# ------------------------------------------------------------------------------
docs/*
!docs/assets/
hermes-qa/
ANALISIS_*.md
PANDUAN_*.md
LAPORAN_*.md
RENCANA_*.md
HARDENING_*.md
PROJECT_*.md
GOALS.md
CONTRIBUTING.md
CHANGELOG.md
RINGKASAN_*.md
CLAUDE_AI_*

# Sembunyikan file dokumen .md ke GitHub (kecuali README.md utama & definisi skill)
*.md
!README.md
!avatar/assets/live2d/**/NOTICE.md
!avatar/assets/models/**/NOTICE.md
!avatar/assets/audio/**/NOTICE.md
!avatar/assets/default-skills/**/README.md
!avatar/assets/default-skills/**/SKILL.md
!avatar/assets/default-skills/**/mandatory.md
!avatar/assets/default-skills/**/skill-card.md
!skills/**/README.md
!skills/**/SKILL.md
!skills/**/mandatory.md
!skills/**/skill-card.md
!extensions/**/README.md
!avatar/extensions/**/README.md

# ------------------------------------------------------------------------------
# 6. FILE TEMPORER, AUDIO TESTING CACHE, & DUMP SCRIPTS
# ------------------------------------------------------------------------------
assets/audio/cache/
avatar/assets/audio/cache/
# Backup aset (mis. tekstur Live2D asli sebelum downscale) — lokal saja, jangan di-commit/bundle
_texture_backup_original/
**/_texture_backup_original/
kokoro_test.wav
dump_*.py
scratch_*.py
scratch/
*.tmp
*.bak

# ------------------------------------------------------------------------------
# 7. PYTHON RUNTIME & ENVIRONMENT
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/

# ------------------------------------------------------------------------------
# 8. SISTEM OPERASI & EDITOR JUNK
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# ------------------------------------------------------------------------------
# 9. REFERENSI PIHAK KETIGA / THIRD-PARTY CLONE
# ------------------------------------------------------------------------------
references/
briefing-attachments/
*.zip
scratch_*.py
